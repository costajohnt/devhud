{
  "name": "devhud",
  "version": "0.1.3",
  "description": "A heads-up display for in-flight Jira and GitHub work: a prioritized TODO list of everything that needs you",
  "license": "MIT",
  "author": "John Costa <costajohnt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costajohnt/devhud.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "devhud": "dist/server/cli.js",
    "devhud-mcp": "dist/mcp/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "lint": "oxlint",
    "test": "npm run lint && npm run typecheck && vitest run",
    "start": "node server/index.ts",
    "cli": "node server/cli.ts",
    "build": "cd web && npm run build && cd .. && node scripts/build.ts",
    "prepack": "npm run build",
    "pack:check": "node scripts/pack-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "files": [
    "dist/",
    "web/dist/",
    "config.example.json"
  ],
  "keywords": [
    "jira",
    "github",
    "dashboard",
    "todo",
    "pull-requests",
    "code-review",
    "mcp",
    "cli"
  ],
  "homepage": "https://github.com/costajohnt/devhud#readme",
  "bugs": {
    "url": "https://github.com/costajohnt/devhud/issues"
  }
}
