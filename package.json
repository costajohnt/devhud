{
  "name": "simon-dash",
  "private": true,
  "description": "Local dashboard for Jira and GitHub PRs: one board, attention-based buckets, no tab hopping",
  "license": "MIT",
  "author": "John Costa <costajohnt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costajohnt/simon-dash.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "simon-dash": "server/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "start": "node server/index.ts",
    "cli": "node server/cli.ts",
    "build": "cd web && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
